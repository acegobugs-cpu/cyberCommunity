"""
Learn — Plan 01, Phase L1 content model.
Enum vocabularies match the CHECK constraints in infra/migrations/learn/V1.
Timestamps are ISO-8601 strings.
"""

enum CourseStatus { DRAFT PUBLISHED ARCHIVED }
enum Difficulty { BEGINNER INTERMEDIATE ADVANCED }
enum LessonType { READING VIDEO QUIZ LAB PROJECT }

# ---------- content ----------

type Course {
  id: ID!
  slug: String!
  title: String!
  description: String
  difficulty: Difficulty!
  tags: [String!]!
  status: CourseStatus!
  "Sum of lesson estimates; maintained by the server."
  estimatedMinutes: Int!
  createdBy: ID
  createdAt: String!
  updatedAt: String!
  archivedAt: String
  modules: [Module!]!
}

type Module {
  id: ID!
  courseId: ID!
  title: String!
  descriptionMd: String
  position: Int!
  createdAt: String!
  updatedAt: String!
  lessons: [Lesson!]!
}

type Lesson {
  id: ID!
  moduleId: ID!
  title: String!
  type: LessonType!
  contentMd: String
  videoUrl: String
  position: Int!
  estimatedMinutes: Int!
  createdAt: String!
  updatedAt: String!
}

# ---------- queries (LEARNER; unpublished content visible to CONTENT_AUTHOR only) ----------

type Query {
  courses(difficulty: Difficulty, tag: String, search: String): [Course!]!
  course(slug: String!): Course
  "Author editor entry point; also works for learners on published courses."
  courseById(id: ID!): Course
  lesson(id: ID!): Lesson
}

# ---------- author mutations (CONTENT_AUTHOR) ----------

"id absent → insert (slug generated from title when omitted); id present → update."
input CourseInput {
  id: ID
  title: String!
  slug: String
  description: String
  difficulty: Difficulty = BEGINNER
  tags: [String!] = []
}

"position omitted on insert → appended at the end."
input ModuleInput {
  id: ID
  courseId: ID!
  title: String!
  descriptionMd: String
  position: Int
}

input LessonInput {
  id: ID
  moduleId: ID!
  title: String!
  type: LessonType = READING
  contentMd: String
  videoUrl: String
  estimatedMinutes: Int = 0
  position: Int
}

type Mutation {
  upsertCourse(input: CourseInput!): Course!
  upsertModule(input: ModuleInput!): Module!
  upsertLesson(input: LessonInput!): Lesson!

  "orderedIds must be exactly the set of the parent's children; positions become 1..n."
  reorderModules(courseId: ID!, orderedIds: [ID!]!): Course!
  reorderLessons(moduleId: ID!, orderedIds: [ID!]!): Module!

  "published=false returns the course to DRAFT."
  publishCourse(id: ID!, published: Boolean = true): Course!
  archiveCourse(id: ID!): Course!

  deleteModule(id: ID!): Boolean!
  deleteLesson(id: ID!): Boolean!
}
