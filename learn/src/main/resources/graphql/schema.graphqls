"""
Learn — Plan 01. L1 content model (paths → modules → lessons), L2 enrollment & progress, L3 roadmaps.
Enum vocabularies match the CHECK constraints in infra/migrations/learn/V1–V3.
Timestamps are ISO-8601 strings; progress values are 0..1.
"""

enum PathStatus { DRAFT PUBLISHED ARCHIVED }
enum Difficulty { BEGINNER INTERMEDIATE ADVANCED }
enum LessonType { READING VIDEO QUIZ LAB PROJECT }
enum EnrollmentStatus { ENROLLED COMPLETED DROPPED }
enum ModuleProgressStatus { STARTED IN_PROGRESS COMPLETED DROPPED }
enum RoadMapStatus { DRAFT PUBLISHED ARCHIVED }
"ALL: every item of the step counts; CHOICE: any one item of the step satisfies it."
enum GroupType { ALL CHOICE }

union RoadMapTarget = Path | Module

# ---------- learner progress (caller-scoped) ----------

type Enrollment {
  pathId: ID!
  status: EnrollmentStatus!
  "Mean of module progress over the path's modules."
  progress: Float!
  enrolledAt: String!
  completedAt: String
  droppedAt: String
  "First lesson the caller has not completed; null when the path is finished."
  nextLessonId: ID
}

type ModuleProgress {
  moduleId: ID!
  status: ModuleProgressStatus!
  "Completed lessons / lessons in module."
  progress: Float!
  startedAt: String!
  completedAt: String
}

# ---------- content ----------

"""
An ordered set of steps pointing at paths / modules. Roadmaps are not enrolled:
`progress` is derived from the caller's enrollments and module progress, so a
learner can see which roadmaps they are already on.
"""
type RoadMap {
  id: ID!
  slug: String!
  title: String!
  descriptionMd: String
  status: RoadMapStatus!
  "Ordered by step then creation. Learners only see items whose target is published."
  items: [RoadMapItem!]!
  "Mean over required steps (ALL → mean of items, CHOICE → best item); non-required items are ignored."
  progress: Float!
  createdBy: ID
  createdAt: String!
  updatedAt: String!
  archivedAt: String
}

type RoadMapItem {
  id: ID!
  "Step number; several items may share a step."
  position: Int!
  groupType: GroupType!
  isRequired: Boolean!
  item: RoadMapTarget!
  "The caller's progress on the target (enrollment or module progress), 0 when untouched."
  progress: Float!
  createdAt: String!
}

type Path {
  id: ID!
  slug: String!
  title: String!
  description: String
  difficulty: Difficulty!
  tags: [String!]!
  status: PathStatus!
  "Sum of lesson estimates; maintained by the server."
  estimatedMinutes: Int!
  createdBy: ID
  createdAt: String!
  updatedAt: String!
  archivedAt: String
  modules: [Module!]!
  "The caller's enrollment, null when never enrolled."
  enrollment: Enrollment
}

type Module {
  id: ID!
  title: String!
  descriptionMd: String
  createdAt: String!
  updatedAt: String!
  lessons: [Lesson!]!
  "Paths that include this module (published only for learners). Used to link module roadmap items."
  paths: [Path!]!
  "The caller's progress in this module (shared across paths), null when never started."
  myProgress: ModuleProgress
}

type Lesson {
  id: ID!
  moduleId: ID!
  title: String!
  type: LessonType!
  contentMd: String
  videoUrl: String
  position: Int!
  estimatedMinutes: Int!
  createdAt: String!
  updatedAt: String!
  completed: Boolean!
}

# ---------- queries (LEARNER; unpublished content visible to CONTENT_AUTHOR only) ----------

"The caller's standing in the learn service."
type Me {
  userId: ID!
  role: String!
  canAuthor: Boolean!
}

type Query {
  me: Me!

  "Catalogue; learners see PUBLISHED only."
  roadmaps(search: String): [RoadMap!]!
  roadmap(slug: String!): RoadMap
  "Author editor entry point; also works for learners on published roadmaps."
  roadmapById(id: ID!): RoadMap
  "Published roadmaps the caller has already made progress on, most advanced first."
  myRoadmaps: [RoadMap!]!

  paths(difficulty: Difficulty, tag: String, search: String): [Path!]!
  path(slug: String!): Path
  "Author editor entry point; also works for learners on published paths."
  pathById(id: ID!): Path

  lesson(id: ID!): Lesson

  "Paths the caller is enrolled in or has completed (dropped excluded), in-progress first."
  myEnrollments: [Path!]!

  "Author picker for reusing modules across paths (CONTENT_AUTHOR)."
  modules(search: String): [Module!]!
}

# ---------- learner mutations (LEARNER) ----------
# All operate on the caller; there is no userId argument.

# ---------- author mutations (CONTENT_AUTHOR) ----------

"id absent → insert (slug generated from title when omitted); id present → update. Status changes go through publishRoadmap / archiveRoadmap."
input RoadMapInput {
  id: ID
  title: String!
  slug: String
  descriptionMd: String
}

"Exactly one of pathId / moduleId. Items sharing a position form one step and must share groupType."
input RoadMapItemInput {
  position: Int!
  groupType: GroupType = ALL
  isRequired: Boolean = true
  pathId: ID
  moduleId: ID
}

"id absent → insert (slug generated from title when omitted); id present → update."
input PathInput {
  id: ID
  title: String!
  slug: String
  description: String
  difficulty: Difficulty = BEGINNER
  tags: [String!] = []
}

"On create, pathId (optional) appends the new module to that path. On update only title/descriptionMd change."
input ModuleInput {
  id: ID
  pathId: ID
  title: String!
  descriptionMd: String
}

input LessonInput {
  id: ID
  moduleId: ID!
  title: String!
  type: LessonType = READING
  contentMd: String
  videoUrl: String
  estimatedMinutes: Int = 0
  position: Int
}

type Mutation {
  "Idempotent; revives a DROPPED enrollment. Path must be PUBLISHED."
  enroll(pathId: ID!): Enrollment!
  dropPath(pathId: ID!): Enrollment!
  """
  Explicit start. Also enrolls in `pathId` when given (must be published and include
  the module); without it, enrolls only if exactly one published path includes the module.
  """
  startModule(moduleId: ID!, pathId: ID): ModuleProgress!
  dropModule(moduleId: ID!): ModuleProgress!
  "READING / VIDEO only; idempotent; starts the module and enrolls implicitly (same pathId rule as startModule)."
  completeLesson(lessonId: ID!, pathId: ID): Lesson!

  # ---------- author mutations (CONTENT_AUTHOR) ----------

  upsertRoadmap(input: RoadMapInput!): RoadMap!
  "Replaces the whole item set; positions are renumbered densely from 1."
  setRoadmapItems(roadmapId: ID!, items: [RoadMapItemInput!]!): RoadMap!
  "Needs ≥1 item. published=false returns the roadmap to DRAFT."
  publishRoadmap(id: ID!, published: Boolean = true): RoadMap!
  archiveRoadmap(id: ID!): RoadMap!
  deleteRoadmap(id: ID!): Boolean!

  upsertPath(input: PathInput!): Path!
  upsertModule(input: ModuleInput!): Module!
  upsertLesson(input: LessonInput!): Lesson!

  "orderedIds must be exactly the set of the parent's children; positions become 1..n."
  reorderModules(pathId: ID!, orderedIds: [ID!]!): Path!
  reorderLessons(moduleId: ID!, orderedIds: [ID!]!): Module!

  "Append an existing module to a path (idempotent) / unlink it (module and lessons survive)."
  addModuleToPath(pathId: ID!, moduleId: ID!): Path!
  removeModuleFromPath(pathId: ID!, moduleId: ID!): Path!

  "published=false returns the path to DRAFT."
  publishPath(id: ID!, published: Boolean = true): Path!
  archivePath(id: ID!): Path!

  deleteModule(id: ID!): Boolean!
  deleteLesson(id: ID!): Boolean!
}
